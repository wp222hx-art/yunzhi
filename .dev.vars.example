# 复制为 .dev.vars（已在 .gitignore 中）。生产环境请用：npx wrangler secret put <NAME>
# 任一 Key 配置后，对应供应商自动"在线"，智能路由只在在线模型中选择；也可在 平台后台 → 算力网关 直接粘贴 Key（优先级高于环境变量）。

# DeepSeek 官方（境内备案池，涉税/敏感业务推荐）
# DEEPSEEK_API_KEY=sk-xxxxxxxx
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 算力网 · 统一算力网关（境内备案池，60+ 模型）
# SUANLI_API_KEY=sk-xxxxxxxx
# SUANLI_BASE_URL=https://api.suanli.com/v1

# 平台托管（海外可控池，GPT-5 系列，OpenAI 兼容）
# PLATFORM_LLM_API_KEY=sk-xxxxxxxx
# PLATFORM_LLM_BASE_URL=https://api.openai.com/v1
